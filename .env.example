# ---------------------------------------------------------------------------
# Jatin Chaurasia — Portfolio configuration
# Copy this file to `.env.local` and fill in the values you have.
# Anything left blank will simply hide the related UI element (no invented
# links or fake data are ever shown).
# ---------------------------------------------------------------------------

# Public site URL (used for canonical links, sitemap, robots.txt, OG tags).
NEXT_PUBLIC_SITE_URL=https://jatinchaurasia.dev

# Social / professional links. Leave empty to render a disabled placeholder
# button instead of a broken or fabricated link. (These are already wired as
# the default fallback in lib/data/profile.ts, so the site works even if you
# don't create a .env.local at all — set them here too if you ever want to
# override without touching code, e.g. for a staging deploy.)
NEXT_PUBLIC_GITHUB_URL=https://github.com/jatin13-14
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/chaurasiajatin/

# Resume. Drop your PDF at /public/resume.pdf (default path below), or point
# this at an external URL (e.g. a hosted PDF).
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# Optional: only needed if you later wire "Ask my portfolio" to a real LLM.
# The client-side assistant ships as a local, static knowledge base by
# default and never requires this. If you add a server route that calls an
# LLM, keep the key server-side only (do NOT prefix it with NEXT_PUBLIC_).
# LLM_API_KEY=
